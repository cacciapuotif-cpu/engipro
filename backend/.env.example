# ── Environment ──────────────────────────────────────────────────────────────
ENV=development
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://engipro:engipro123@localhost:5432/engipro
SQLALCHEMY_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO (must match MINIO_ROOT_PASSWORD in docker-compose) ─────────────────
MINIO_URL=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=engipro
MINIO_SECURE=false
# Browser-reachable host:port for signed downloads; no scheme or path.
# Leave empty only if MINIO_URL is already reachable by the browser.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=true
MINIO_REGION=us-east-1

# ── JWT Security ──────────────────────────────────────────────────────────────
# CRITICAL: replace with a strong random value in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost"]

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_FILE_SIZE=52428800

# ── 2FA ───────────────────────────────────────────────────────────────────────
TWO_FACTOR_ENABLED=false

# Required for first seed in every environment; never commit the actual value.
ADMIN_INITIAL_PASSWORD=
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128

# Rate limiting: fixed 60-second windows. Trust only the actual Nginx address/CIDR.
AUTH_RATE_LIMIT_REQUESTS=10
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_PERIOD_SECONDS=60
TRUSTED_PROXY_NETWORKS=[]
